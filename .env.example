# ═══════════════════════════════════════════════════════════════════
#  DAO Governance Platform — Environment Configuration
# ═══════════════════════════════════════════════════════════════════
#  ⚠️  SECURITY: Copy this file to .env and fill in your values.
#       NEVER commit .env to version control.
#       .env is already listed in .gitignore.
# ═══════════════════════════════════════════════════════════════════

# ─── Wallet ─────────────────────────────────────────────────────
# Deployer private key — WITHOUT the 0x prefix
# Use a dedicated deployer wallet, NOT your main wallet.
# For local development, Hardhat provides default accounts automatically.
PRIVATE_KEY=1c5789045cf4803b4ac807673c156b9fbe8f2c49b2d250f9fbdf70d620499d35

# ─── RPC Endpoints ──────────────────────────────────────────────
# Alchemy (recommended) or Infura — get free keys at:
#   https://dashboard.alchemy.com
#   https://infura.io/dashboard
ALCHEMY_AMOY_URL=https://polygon-amoy.g.alchemy.com/v2/N4ibwQEVpwI75-DUjQl_p
ALCHEMY_SEPOLIA_URL=https://eth-sepolia.g.alchemy.com/v2/N4ibwQEVpwI75-DUjQl_p

# ─── Block Explorer API Keys ────────────────────────────────────
# Required for contract verification via `npx hardhat verify`
# Get keys at:
#   https://polygonscan.com/myapikey
#   https://etherscan.io/myapikey
POLYGONSCAN_API_KEY=your_polygonscan_api_key
ETHERSCAN_API_KEY=5VAKKEYC4JM52TBU4JVSD6GSJC4ICJ6YXQ

# ─── IPFS ───────────────────────────────────────────────────────
# Gateway for fetching proposal metadata (descriptions, attachments)
# Options: Pinata, Infura IPFS, nft.storage, or self-hosted
IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
PINATA_API_KEY=77817db77052f53ee60a
PINATA_SECRET_KEY=2aaa7c2315651f21f0ec0db5ecdc9453046f1e6587aaf0497ab48106488caecd

# ─── Gas Reporter ───────────────────────────────────────────────
# Set to "true" to generate gas usage reports during tests
REPORT_GAS=false
COINMARKETCAP_API_KEY=your_coinmarketcap_api_key

# ─── Frontend (VITE_ prefix exposes to browser — NO secrets here) ──
# These are populated after deployment. See scripts/deploy.ts output.
VITE_GOVERNANCE_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000
VITE_GOVERNOR_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TIMELOCK_ADDRESS=0x0000000000000000000000000000000000000000
VITE_TREASURY_ADDRESS=0x0000000000000000000000000000000000000000

# Active chain: 31337 (localhost), 80002 (Polygon Amoy), 11155111 (Sepolia)
VITE_CHAIN_ID=80002

# Public Alchemy API key for frontend reads (rate-limited, safe to expose)
VITE_ALCHEMY_API_KEY=your_alchemy_api_key

# IPFS gateway for the frontend to render proposal metadata
VITE_IPFS_GATEWAY_URL=https://gateway.pinata.cloud/ipfs/
